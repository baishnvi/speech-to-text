PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/speech_to_text
# Set to true on managed Postgres (Render, Neon, Supabase...)
PGSSL=false
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Live-capable Gemini model. Check the Live API docs for the latest model name.
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025
# Comma separated origins, or * for all
CORS_ORIGIN=*
